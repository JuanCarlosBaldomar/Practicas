#include <iostream>
#include <string>
using namespace std;


void leer(int &n);
string convertir(int n);
void mostrar(int n, string letras);

int main() {
    int n;
    string letras;

    leer(n);
    letras = convertir(n);
    mostrar(n, letras);

    return 0;
}


void leer(int &n) {
    do {
        cout << "Ingrese un numero entre 0 y 20: ";
        cin >> n;
    } while (n < 0 || n > 20);
}

string convertir(int n) {
    string numeros[] = {
        "cero", "uno", "dos", "tres", "cuatro",
        "cinco", "seis", "siete", "ocho", "nueve",
        "diez", "once", "doce", "trece", "catorce",
        "quince", "dieciseis", "diecisiete",
        "dieciocho", "diecinueve", "veinte"
    };

    return numeros[n];
}

void mostrar(int n, string letras) {
    cout << "El numero " << n << " se escribe: "
         << letras << endl;
}
