#include <iostream>
#include <cmath>

using namespace std;
int main () {

double a;
double b;
double c;

cout << "=== Resolucion de Ecuacion Cuadratica ===" << endl;
cout << "Ingrese el coeficiente a: ";
cin >> a;
cout << "Ingrese el coeficiente b: ";
cin >> b;
cout << "Ingrese el coeficiente c: ";
cin >> c;

// Validacion si a es 0
if (a == 0) {
        cout << "\nEl coeficiente 'a' no puede ser 0. Es una ecuacion lineal." << endl;
        if (b != 0) {
                double x = -c / b;
        cout << "La solucion lineal es x = " << x << endl;
        } else {
            cout << "No hay solucion valida." << endl;
        }
        return 0;        
}


double discriminante = b * b - 4 * a * c;

    cout << "\nDiscriminante (D) = " << discriminante << endl;

    if (discriminante > 0) {
        // Dos raíces reales y distintas
        double x1 = (-b + sqrt(discriminante)) / (2 * a);
        double x2 = (-b - sqrt(discriminante)) / (2 * a);
        cout << "Existen dos raices reales distintas:" << endl;
        cout << "x1 = " << x1 << endl;
        cout << "x2 = " << x2 << endl;
    } else if (discriminante == 0) {
        // Una raíz real doble
        double x = -b / (2 * a);
        cout << "Existe una unica raiz real doble:" << endl;
        cout << "x1 = x2 = " << x << endl;
    } else {
        // Raíces complejas / imaginarias
        double parteReal = -b / (2 * a);
        double parteImaginaria = sqrt(-discriminante) / (2 * a);
        cout << "Las raices son complejas/imaginarias:" << endl;
        cout << "x1 = " << parteReal << " + " << parteImaginaria << "i" << endl;
        cout << "x2 = " << parteReal << " - " << parteImaginaria << "i" << endl;
    }

    return 0;
}
