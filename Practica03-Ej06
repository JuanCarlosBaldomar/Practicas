#include <iostream>

using namespace std;

int main() {
    int d1, m1, d2, m2;

    cout << "=== Diferencia entre dos fechas del mismo ano ===" << endl;
    cout << "Ingrese fecha inicial (DD MM): ";
    cin >> d1 >> m1;

    cout << "Ingrese fecha final (DD MM): ";
    cin >> d2 >> m2;

    // Convertir ambas fechas a dias totales del año (asumiendo meses de 30 días)
    int totalDias1 = (m1 - 1) * 30 + d1;
    int totalDias2 = (m2 - 1) * 30 + d2;

    if (totalDias2 < totalDias1) {
        cout << "La fecha final debe ser posterior a la fecha inicial." << endl;
        return 1;
    }

    int diferenciaDias = totalDias2 - totalDias1;
    int meses = diferenciaDias / 30;
    int dias = diferenciaDias % 30;

    cout << "\nDiferencia: " << meses << " meses " << dias << " dias." << endl;

    return 0;
}
