#include <iostream>
using namespace std;
void registrar(int A[], int n);
void ordenar(int A[], int n);
void mostrar(int A[], int n);

int main() {
    int A[100], n;

    do {
        cout << "Cantidad de elementos (1 a 100): ";
        cin >> n;
    } while (n < 1 || n > 100);

    registrar(A, n);

    cout << "\nVector original: ";
    mostrar(A, n);

    ordenar(A, n);

    cout << "Vector ordenado: ";
    mostrar(A, n);

    return 0;
}
void registrar(int A[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> A[i];
    }
}

void ordenar(int A[], int n) {
    int aux;

    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - 1 - i; j++) {
            if (A[j] > A[j + 1]) {
                aux = A[j];
                A[j] = A[j + 1];
                A[j + 1] = aux;
            }
        }
    }
}

void mostrar(int A[], int n) {
    for (int i = 0; i < n; i++) {
        cout << A[i] << " ";
    }
    cout << endl;
}
