#include <iostream>
using namespace std;
void leer(int &n);
void generar(unsigned long long A[], int n);
void mostrar(unsigned long long A[], int n);

int main() {
    unsigned long long A[94];
    int n;

    leer(n);
    generar(A, n);
    mostrar(A, n);

    return 0;
}


void leer(int &n) {
    do {
        cout << "Ingrese la cantidad de terminos (1 a 94): ";
        cin >> n;
    } while (n < 1 || n > 94);
}

void generar(unsigned long long A[], int n) {
    A[0] = 0;

    if (n > 1) {
        A[1] = 1;
    }

    for (int i = 2; i < n; i++) {
        A[i] = A[i - 1] + A[i - 2];
    }
}

void mostrar(unsigned long long A[], int n) {
    cout << "\nSerie de Fibonacci:\n";

    for (int i = 0; i < n; i++) {
        cout << A[i] << " ";
    }

    cout << endl;
}
