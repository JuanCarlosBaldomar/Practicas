        cin >> notas[n];
    } while (notas[n] < 0 || notas[n] > 100);

    n++;

    cout << "Alumno registrado.\n";
}

void listar(string nombres[], float notas[], int n) {
    if (n == 0) {
        cout << "No hay alumnos registrados.\n";
        return;
    }

    cout << "\nLISTA DE ALUMNOS\n";

    for (int i = 0; i < n; i++) {
        cout << i + 1 << ". " << nombres[i]
             << " - Nota: " << notas[i] << endl;
    }
}

void ordenar(string nombres[], float notas[], int n) {
    string auxNombre;
    float auxNota;

    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - 1 - i; j++) {
            if (nombres[j] > nombres[j + 1]) {
                auxNombre = nombres[j];
                nombres[j] = nombres[j + 1];
                nombres[j + 1] = auxNombre;

                auxNota = notas[j];
                notas[j] = notas[j + 1];
                notas[j + 1] = auxNota;
            }
        }
    }
}

void mostrarMayor(string nombres[], float notas[], int n) {
    if (n == 0) {
        cout << "No hay alumnos registrados.\n";
        return;
    }

    float mayor = notas[0];

    for (int i = 1; i < n; i++) {
        if (notas[i] > mayor) {
            mayor = notas[i];
        }
    }

    cout << "\nNota mas alta: " << mayor << endl;
    cout << "Alumno(s) con esa nota:\n";

    for (int i = 0; i < n; i++) {
        if (notas[i] == mayor) {
            cout << nombres[i] << endl;
        }
    }
}

float promedio(float notas[], int n) {
    float suma = 0;

    for (int i = 0; i < n; i++) {
        suma += notas[i];
    }

    return suma / n;
}

void mostrarPromedio(float notas[], int n) {
    if (n == 0) {
        cout << "No hay alumnos registrados.\n";
        return;
    }

    float prom = promedio(notas, n);

    cout << "Promedio de notas: " << prom << endl;
}
