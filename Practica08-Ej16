#include <iostream>
#include <string>
using namespace std;

// PROTOTIPOS
void registrar(string nombres[], float notas[], int &n);
void listar(string nombres[], float notas[], int n);
void ordenar(string nombres[], float notas[], int n);
void mostrarMayor(string nombres[], float notas[], int n);
float promedio(float notas[], int n);
void mostrarPromedio(float notas[], int n);

int main() {
    string nombres[100];
    float notas[100];
    int n = 0, opcion;

    do {
        cout << "\n===== MENU DE ALUMNOS =====\n";
        cout << "1. Registrar alumno y nota\n";
        cout << "2. Listar alumnos\n";
        cout << "3. Ordenar por nombre\n";
        cout << "4. Mostrar nota mas alta\n";
        cout << "5. Calcular promedio\n";
        cout << "6. Salir\n";
        cout << "Seleccione una opcion: ";
        cin >> opcion;

        switch (opcion) {
            case 1:
                registrar(nombres, notas, n);
                break;

            case 2:
                listar(nombres, notas, n);
                break;

            case 3:
                if (n > 0) {
                    ordenar(nombres, notas, n);
                    cout << "Alumnos ordenados.\n";
                    listar(nombres, notas, n);
                }
                else {
                    cout << "No hay alumnos.\n";
                }
                break;

            case 4:
                mostrarMayor(nombres, notas, n);
                break;

            case 5:
                mostrarPromedio(notas, n);
                break;

            case 6:
                cout << "Saliendo del programa...\n";
                break;

            default:
                cout << "Opcion no valida.\n";
        }

    } while (opcion != 6);

    return 0;
}

// FUNCIONES

