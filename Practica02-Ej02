Algoritmo SumaDosNumeros
	// Declaración de variables
	Definir num1, num2, suma Como Entero
	
	// Entrada de datos
	Escribir "Ingrese el primer número entero: "
	Leer num1
	
	Escribir "Ingrese el segundo número entero: "
	Leer num2
	
	// Proceso
	suma <- num1 + num2
	
	// Salida de datos
	Escribir ""
	Escribir "La suma de los dos números es: ", suma
FinAlgoritmo
