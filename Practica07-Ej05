#include <iostream>
#include <string>
using namespace std;

bool SISTEMA(double A, double B, double C,
             double D, double E, double F,
             double &X, double &Y);

int main() {
    double X, Y;

    if (SISTEMA(1, 2, 3, 4, 5, 6, X, Y)) {
        cout << "X = " << X << endl;
        cout << "Y = " << Y << endl;
    } else {
        cout << "El sistema no tiene solucion unica." << endl;
    }

    return 0;
}

bool SISTEMA(double A, double B, double C,
             double D, double E, double F,
             double &X, double &Y) {
    double det = A * E - B * D;

    if (det == 0)
        return false;

    X = (B * F - C * E) / det;
    Y = (C * D - A * F) / det;
    return true;
}
