#include <iostream>
#include <string>
using namespace std;

void ROMANO(int n);

int main() {
    int n;
    cout << "Ingrese un numero entre 1 y 3999: ";
    cin >> n;

    ROMANO(n);
    return 0;
}

void ROMANO(int n) {
    int valores[] = {
        1000, 900, 500, 400, 100, 90, 50, 40,
        10, 9, 5, 4, 1
    };

    string simbolos[] = {
        "M", "CM", "D", "CD", "C", "XC", "L",
        "XL", "X", "IX", "V", "IV", "I"
    };

    if (n < 1 || n > 3999) {
        cout << "Numero fuera del rango." << endl;
        return;
    }

    cout << "En romano: ";
    for (int i = 0; i < 13; i++) {
        while (n >= valores[i]) {
            cout << simbolos[i];
            n -= valores[i];
        }
    }
    cout << endl;
}
