#include <iostream>

using namespace std;

int main() {
    // Declaracion de variables
    int horasTrabajadas;
    double pagoPorHora, salarioBase, bono = 0.0, salarioTotal;

    // Entrada de datos
    cout << "Ingrese la cantidad de horas trabajadas: ";
    cin >> horasTrabajadas;

    cout << "Ingrese el pago por hora (Bs): ";
    cin >> pagoPorHora;

    // Proceso y Condicional
    salarioBase = horasTrabajadas * pagoPorHora;

    if (horasTrabajadas > 40) {
        bono = salarioBase * 0.10;
        cout << "Corresponde un bono adicional del 10%: " << bono << " Bs." << endl;
    } else {
        cout << "No corresponde bono adicional." << endl;
    }

    salarioTotal = salarioBase + bono;

    // Salida de datos
    cout << "\nEl salario total a pagar es: " << salarioTotal << " Bs." << endl;

    return 0;
}
