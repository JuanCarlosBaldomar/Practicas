#include <iostream>
using namespace std;

void registrar(int A[], int n);
void invertir(int A[], int B[], int n);
void mostrar(int A[], int B[], int n);

int main() {
    int A[100], B[100], n;
    
cout << "Ingrese la cantidad de numeros: ";
cin >> n;

registrar(A, n);

invertir(A, B, n);

cout << "\nRESULTADOS" << endl;
mostrar(A, B, n);



return 0;    
}

void registrar(int A[], int n) {
for (int i = 0; i < n; i++){
cout << "Numero " << i + 1 << ": ";
cin >> n;
    }
}

void invertir(int A[], int B[], int n) {
    for(int i = 0; i < n; i++){
        B[i] = A[n - 1 - i];
    }
}

void mostrar(int A[], int B[], int n) {
    cout << "Vector original: ";
    for(int i = 0; i < n; i++){
        cout << A[i] << " ";
        }
    cout << "\nVector invertido: ";
    for(int i = 0; i < n; i++) {
    cout << B[i] << " ";}
    } 
