#include <iostream>
using namespace std;


void registrar(int A[], int n);
void invertir(int A[], int n);
void mostrar(int A[], int n);

int main() {
    int A[100], n;

    do {
        cout << "Cantidad de elementos (1 a 100): ";
        cin >> n;
    } while (n < 1 || n > 100);

    registrar(A, n);

    cout << "\nVector original: ";
    mostrar(A, n);

    invertir(A, n);

    cout << "Vector invertido: ";
    mostrar(A, n);

    return 0;
}


void registrar(int A[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> A[i];
    }
}

void invertir(int A[], int n) {
    int aux;

    for (int i = 0; i < n / 2; i++) {
        aux = A[i];
        A[i] = A[n - 1 - i];
        A[n - 1 - i] = aux;
    }
}

void mostrar(int A[], int n) {
    for (int i = 0; i < n; i++) {
        cout << A[i] << " ";
    }
    cout << endl;
}
